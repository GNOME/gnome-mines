#: data/org.gnome.Mines.metainfo.xml.in:8 data/org.gnome.Mines.desktop.in:2
#: src/interface.ui:48 src/gnome-mines.vala:131 src/gnome-mines.vala:747
msgid "Mines"
msgstr "Miner"

#
#: data/org.gnome.Mines.metainfo.xml.in:9 data/org.gnome.Mines.desktop.in:3
msgid "Clear hidden mines from a minefield"
msgstr "Fjern gøymde miner frå eit minefelt"

#: data/org.gnome.Mines.metainfo.xml.in:11
msgid ""
"Mines is a puzzle game where you search for hidden mines. Flag the spaces "
"with mines as quickly as possible to make the board a safer place. You win "
"the game when you’ve flagged every mine on the board. Be careful not to "
"trigger one, or the game is over!"
msgstr ""
"Mines er eit puslespel der du leitar etter gøymde miner. Flagg rutene med "
"miner så raskt som mogleg for å gjere brettet tryggare. Du vinn spelet når "
"du har flagga kvar mine på brettet. Pass på at du ikkje utløyser nokon, "
"elles er spelet over!"

#: data/org.gnome.Mines.metainfo.xml.in:17
msgid ""
"You can select the size of the field you want to play on at the start of the "
"game. If you get stuck, you can ask for a hint: there’s a time penalty, but "
"that’s better than hitting a mine!"
msgstr ""
"Du kan velje kor stort felt du vil spele på ved starten av spelet. Viss du "
"står fast, kan du be om eit hint: det gjev tidstillegg, men det er betre enn"
" å treffe ei mine!"

#: data/org.gnome.Mines.metainfo.xml.in:143
msgid "Robert Roth"
msgstr "Robert Roth"

